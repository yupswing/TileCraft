@echo off
rem Builds a native Windows .exe (no Haxe/Neko needed to run it) via HXCPP.
rem Requires: Visual Studio Build Tools (Desktop development with C++ workload)
rem and hxcpp 3.4.64 (NOT 3.3.x or earlier -- Haxe 3.4.x requires hxcpp >= 3.4.49,
rem older hxcpp generates "hx::Ctx" constructor signatures the Haxe 3.4.7 compiler
rem no longer emits correctly).
rem
rem Usage: dev-native.bat   (run from the project root, or anywhere -- it cd's itself)

set PATH=C:\Program Files (x86)\Microsoft Visual Studio\Installer;%PATH%
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat" x64_x86
if errorlevel 1 (
   echo Could not set up the MSVC x86 toolchain - is VS Build Tools installed?
   exit /b 1
)

rem Modern MSVC dropped the legacy "typeinfo.h" header that old hxcpp's
rem hxcpp.h still includes; this shim provides it without patching hxcpp itself.
set INCLUDE=C:\HaxeToolkit\msvc_compat_include;%INCLUDE%

set HAXEPATH=C:\HaxeToolkit\haxe34
set NEKOPATH=C:\HaxeToolkit\neko32
set HXCPP_COMPILE_THREADS=1
set PATH=C:\HaxeToolkit\haxe34;C:\HaxeToolkit\neko32;%PATH%

cd /d "%~dp0"
"C:\HaxeToolkit\haxe34\lime.exe" build windows -Dv2 -Dlegacy -Drelease -DHXCPP_MSVC_CUSTOM
if errorlevel 1 (
   echo Build failed.
   exit /b 1
)

rem The real Nvidia 32-bit OpenGL driver (nvoglv32.dll) crashes (access violation)
rem on this lime 2.9.1 GL renderer regardless of project content -- see README.
rem Dropping in Mesa's software opengl32.dll/libgallium_wgl.dll next to the exe
rem (see vendor\mesa-x86\, not committed -- see README for how to get them) and
rem forcing the llvmpipe software rasterizer avoids the crash entirely.
rem
rem TileCraft.exe itself has NO idea about this -- launching it directly (double
rem click, or from another shell) uses the real Nvidia driver and crashes. Always
rem use "TileCraft Launcher.bat" (written below, next to the exe) instead, which
rem sets the required env vars first. This script also uses it, for consistency.
if exist "vendor\mesa-x86\opengl32.dll" (
   copy /Y "vendor\mesa-x86\opengl32.dll" "Export\windows\cpp\bin\opengl32.dll" >nul
   copy /Y "vendor\mesa-x86\libgallium_wgl.dll" "Export\windows\cpp\bin\libgallium_wgl.dll" >nul

   > "Export\windows\cpp\bin\TileCraft Launcher.bat" (
      echo @echo off
      echo rem Runs TileCraft.exe against Mesa's software OpenGL instead of the
      echo rem real Nvidia driver, which crashes this old lime 2.9.1 GL renderer.
      echo rem See README.md for details. Regenerated by dev-native.bat every build.
      echo set GALLIUM_DRIVER=llvmpipe
      echo set LIBGL_ALWAYS_SOFTWARE=1
      echo cd /d "%%~dp0"
      echo start "" "TileCraft.exe"
   )
) else (
   echo WARNING: vendor\mesa-x86\opengl32.dll not found - running against the real
   echo Nvidia driver, which is known to crash. See README for how to set up Mesa.
)

echo.
echo Build succeeded: Export\windows\cpp\bin\TileCraft.exe
echo Launching...
if exist "Export\windows\cpp\bin\TileCraft Launcher.bat" (
   start "" /D "Export\windows\cpp\bin" "TileCraft Launcher.bat"
) else (
   start "" /D "Export\windows\cpp\bin" "TileCraft.exe"
)
